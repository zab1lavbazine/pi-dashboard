{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Dashboard Experimental",
  "version": "0.1.0",
  "identifier": "dev.pi-dashboard.experimental",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pi Dashboard · Experimental",
        "width": 800,
        "height": 480,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
